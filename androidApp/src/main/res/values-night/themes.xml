<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark: true black behind the startup screen and the window (the stock theme is grey). -->
    <style name="Theme.Veil" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
